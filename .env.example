# Anvia Lens observability (opsional — kosong = disabled)
# production pakai Lens self-host di compose yang sama (--profile lens):
#   ANVIA_LENS_BASE_URL="http://lens-web:8080"  (dari container; browser: http://localhost:$LENS_WEB_PORT)
ANVIA_LENS_BASE_URL=""
ANVIA_LENS_PUBLIC_KEY=""
ANVIA_LENS_SECRET_KEY=""
ANVIA_LENS_SERVICE_NAME=""
ANVIA_LENS_ENVIRONMENT="production"

# Lens stack secrets (docker compose --profile lens up) — generate: openssl rand -hex 32
LENS_VERSION=0.4.1
LENS_WEB_PORT=4010
LENS_PUBLIC_APP_URL=http://localhost:4010
LENS_WEB_ORIGIN=http://localhost:4010
LENS_POSTGRES_PASSWORD=""
LENS_REDIS_PASSWORD=""
LENS_CLICKHOUSE_PASSWORD=""
LENS_BETTER_AUTH_SECRET=""
LENS_INGESTION_KEY_PEPPER=""

# MCP server launch (opsional — default: tsx apps/mcp-server/src/index.ts)
# MCP_SERVER_COMMAND="node apps/mcp-server/dist/index.js"
