{
  "name": "platform",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "test": "vitest run",
    "eval": "dotenv -e ../../.env -- tsx src/eval.ts",
    "agent": "dotenv -e ../../.env -- tsx src/cli.ts",
    "reminder-worker": "dotenv -e ../../.env -- tsx src/reminder-worker.ts"
  },
  "dependencies": {
    "@anvia/channel": "^0.4.0",
    "@anvia/core": "^1.5.0",
    "@anvia/lens": "^1.2.0",
    "@anvia/mcp": "^1.1.3",
    "@anvia/mistral": "^1.1.3",
    "@anvia/qdrant": "^1.1.3",
    "@anvia/telegram": "^0.3.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.0",
    "@second-brain/agent": "workspace:*",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}